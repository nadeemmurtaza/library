{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untitled UI Component Registry Item",
  "type": "object",
  "required": [
    "name",
    "type"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "The component identifier"
    },
    "type": {
      "type": "string",
      "enum": [
        "registry:ui",
        "registry:component",
        "registry:example",
        "registry:block",
        "registry:hook",
        "registry:theme"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "devDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "cssVars": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object"
        },
        "dark": {
          "type": "object"
        },
        "theme": {
          "type": "object"
        }
      }
    }
  }
}